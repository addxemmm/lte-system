# ---> Go
bin/
*.exe

# ---> Data / runtime (never commit live state)
/data/
var/log/*.log
var/log/*.pcap
*.pcap
!configs/*.example

# ---> Firmware binaries are intentionally tracked (small .bin), but ignore vendor zips
firmware/**/*.zip
*.zip

# ---> Runtime junk (never commit live state)
*.backtrace.crash

# ---> OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local secrets and generated state (examples remain tracked)
.env
.env.*
configs/app.yaml
**/user_db.csv
**/wordlist.list
**/*_run.conf
**/last_start.json
**/__pycache__/
*.pyc
*.log
!docs/samples/*.log

/.codex-go-cache*/
