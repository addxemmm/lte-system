listen_addr: ":8081"
# 前端始终启用；独立后端监听默认关闭。 / UI enabled; direct API listener disabled by default.
ui_listen_addr: ":8080"
# 默认接受 IP/localhost；自定义域名需列入此处（无协议/端口）。
# Literal IP/localhost work by default; explicitly list custom DNS hostnames.
ui_allowed_hosts: []
expose_api: false
# 测试同时开放：LTE_EXPOSE_API=true，并使用 docker-compose.test.yml。
# Dual-port testing: LTE_EXPOSE_API=true plus docker-compose.test.yml.
# 固定 API Token；留空允许匿名访问。修改后重启 API，不要提交真实 Token。
# Static API token; empty allows anonymous access. Restart API after changes.
# A nonempty LTE_API_TOKEN overrides this value; an empty env value does not.
api_token: ""
data_dir: "/data"
conf_dir: ""
log_dir: ""

srsepc_bin: "srsepc"
srsenb_bin: "srsenb"
tcpdump_bin: "tcpdump"
tshark_bin: "tshark"
hashcat_bin: "hashcat"
pysim_dir: "/opt/pysim"

default_sdr: "auto"
# "auto" device_args + detected B210 => server injects VM-USB-stable UHD args
# (recv/send_frame_size=9232, num frames 64). Explicit args always win.
default_device_args: "auto"
default_tx_gain: 80
default_rx_gain: 40
# 25 = 5MHz, VM-USB safe. Use 50/100 on bare metal.
default_n_prb: 25
# DNS handed to UEs via PCO. If the uplink filters public DNS,
# point at the LAN resolver (e.g. the gateway 192.0.2.1).
default_dns: "8.8.8.8"
# Operator name shown on the UE (NITZ). Legacy display was "srsRAN".
default_full_net_name: "srsRAN"
default_short_net_name: "srsRAN"

sim_defaults:
  ki: "00112233445566778899aabbccddeeff"
  opc: "63bfa50ee6523365ff14c1f45f88737d"
  op: ""
  op_type: "opc"
  auth: "mil"
  amf: "8001"
  acc: "FFFF"
  adm: "3030303030303030"
  spn: "LTESystem"
  iccid: "89860123456789012345"
  card: "testsim"
  qci: 7

pcap_lte_data: "lte_data.pcap"
pcap_enb: "srsLTE_enb.pcap"
pcap_s1ap: "srsLTE_enb_s1ap.pcap"
pcap_epc: "srsLTE_epc.pcap"
epc_log_name: "srsLTE_epc.log"
enb_log_name: "srsLTE_enb.log"
max_upload_bytes: 8388608
