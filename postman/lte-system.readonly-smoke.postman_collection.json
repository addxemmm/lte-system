{
  "info": {
    "name": "lte-system API v3 — read-only smoke",
    "description": "UNRELEASED DRAFT / 未发布草稿: final integrity revisions are unvalidated and not deployed. Do not infer current server support. Six non-mutating GET checks for API envelopes and configuration/session evidence only. This collection does not start or stop RF, write SIM/subscriber data, download captures, run crack jobs, or prove that a phone can reach the Internet or DNS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://HOST:8081",
      "description": "Set to the lte-system API origin; do not include /api/v1"
    },
    {
      "key": "token",
      "value": "",
      "description": "Set only when LTE_API_TOKEN is enabled"
    }
  ],
  "item": [
    {
      "name": "Read-only smoke",
      "item": [
        {
          "name": "GET /api/v1/cell",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/cell",
            "description": "network is the requested policy; resolved_network is the selected interface."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('HTTP 200 with successful standard envelope', () => {",
                  "  pm.expect(pm.response.code === 200).to.eql(true);",
                  "  pm.expect(j.code === 0).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('cell status schema', () => {",
                  "  pm.expect(typeof j.data.running === 'boolean').to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/v1/network",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/network",
            "description": "Read-only effective Manager plan: active, ue_subnet, sgi_address, ue_access, resolved_network. Configuration only; it does not assert Internet or DNS reachability."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('HTTP 200 with successful standard envelope', () => {",
                  "  pm.expect(pm.response.code === 200).to.eql(true);",
                  "  pm.expect(j.code === 0).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('network plan is configuration-only', () => {",
                  "  const required = ['active', 'ue_subnet', 'sgi_address', 'ue_access'];",
                  "  pm.expect(required.every(k => Object.prototype.hasOwnProperty.call(j.data, k))).to.eql(true);",
                  "  pm.expect(typeof j.data.active === 'boolean').to.eql(true);",
                  "  pm.expect(!Object.prototype.hasOwnProperty.call(j.data, 'internet_reachable')).to.eql(true);",
                  "  pm.expect(!Object.prototype.hasOwnProperty.call(j.data, 'dns_reachable')).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/v1/ues",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/ues",
            "description": "Authoritative bounded multi-UE snapshot. missing/stale/invalid/cell_stopped with sessions=[] means no current snapshot, not no UE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('HTTP 200 with successful standard envelope', () => {",
                  "  pm.expect(pm.response.code === 200).to.eql(true);",
                  "  pm.expect(j.code === 0).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('bounded UE snapshot schema', () => {",
                  "  const allowed = ['current', 'missing', 'stale', 'invalid', 'cell_stopped'];",
                  "  pm.expect(allowed.includes(j.data.state)).to.eql(true);",
                  "  pm.expect(Array.isArray(j.data.sessions)).to.eql(true);",
                  "  pm.expect(Number.isInteger(j.data.count) && j.data.count === j.data.sessions.length).to.eql(true);",
                  "  if (j.data.state === 'current') pm.expect(j.data.cell_state === 'running').to.eql(true);",
                  "  if (j.data.state !== 'current') {",
                  "    pm.expect(j.data.sessions.length === 0 && !Object.prototype.hasOwnProperty.call(j.data, 'schema_version')).to.eql(true);",
                  "    return;",
                  "  }",
                  "  pm.expect([1, 2].includes(j.data.schema_version)).to.eql(true);",
                  "  for (const s of j.data.sessions) {",
                  "    pm.expect(typeof s.apn_validated === 'boolean' && ['omitted', 'pdn_request', 'esm_information_response'].includes(s.apn_source)).to.eql(true);",
                  "    for (const field of ['requested_apn', 'selected_apn']) if (Object.prototype.hasOwnProperty.call(s, field)) pm.expect(typeof s[field] === 'string').to.eql(true);",
                  "    const selected = typeof s.selected_apn === 'string' ? s.selected_apn : '';",
                  "    const requested = typeof s.requested_apn === 'string' ? s.requested_apn : '';",
                  "    if (j.data.schema_version === 1) {",
                  "      pm.expect(!Object.prototype.hasOwnProperty.call(s, 'access_policy') && !Object.prototype.hasOwnProperty.call(s, 'access_reason')).to.eql(true);",
                  "      pm.expect(!selected || s.apn_validated === true).to.eql(true);",
                  "      continue;",
                  "    }",
                  "    pm.expect(['normal', 'restricted', 'deny'].includes(s.access_policy)).to.eql(true);",
                  "    if (s.access_policy === 'normal') {",
                  "      pm.expect(s.apn_validated === true && selected.length > 0).to.eql(true);",
                  "      if (s.apn_source === 'omitted') pm.expect(requested === '' && s.access_reason === 'apn_omitted').to.eql(true);",
                  "      else pm.expect(['pdn_request', 'esm_information_response'].includes(s.apn_source) && requested.length > 0 && requested.toLowerCase() === selected.toLowerCase() && s.access_reason === 'apn_match').to.eql(true);",
                  "    } else if (s.access_policy === 'restricted') {",
                  "      pm.expect(s.apn_validated === false && s.access_reason === 'apn_mismatch').to.eql(true);",
                  "      pm.expect(['pdn_request', 'esm_information_response'].includes(s.apn_source) && requested.length > 0 && selected.length > 0 && requested.toLowerCase() !== selected.toLowerCase()).to.eql(true);",
                  "    } else {",
                  "      pm.expect(s.apn_validated === false && s.access_reason === 'session_unavailable' && selected === '').to.eql(true);",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/v1/subscribers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/subscribers?limit=50&offset=0",
            "description": "Redacted authorization config. active=null is distinct from authorized=true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('HTTP 200 with successful standard envelope', () => {",
                  "  pm.expect(pm.response.code === 200).to.eql(true);",
                  "  pm.expect(j.code === 0).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('redacted subscriber page schema', () => {",
                  "  pm.expect(Array.isArray(j.data.items)).to.eql(true);",
                  "  pm.expect(Number.isInteger(j.data.total) && Number.isInteger(j.data.limit) && Number.isInteger(j.data.offset)).to.eql(true);",
                  "  pm.expect(j.data.items.every(x => !['key','sqn','op','opc','amf'].some(k => Object.prototype.hasOwnProperty.call(x, k)))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/v1/profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/profile",
            "description": "Saved cell profile only; use /subscribers and /ues for their separate resources."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('HTTP 200 with successful standard envelope', () => {",
                  "  pm.expect(pm.response.code === 200).to.eql(true);",
                  "  pm.expect(j.code === 0).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('profile schema', () => {",
                  "  pm.expect(typeof j.data.has_profile === 'boolean').to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /api/v1/diagnostics/connectivity",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/diagnostics/connectivity",
            "description": "Read-only layered evidence. Does not stop the cell, capture new traffic, probe outside, or return credentials. 429 diagnostic_busy is expected for overlap. Live capture integrity is metadata only; incomplete scans are not proof of absent authentication. 不完整抓包不等于无认证，原抓包不变。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('diagnostics has an exact evidence-or-busy envelope', () => {",
                  "  pm.expect([200, 429].includes(pm.response.code)).to.eql(true);",
                  "  pm.expect(typeof j.request_id === 'string' && j.request_id.length > 0).to.eql(true);",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(j.code === 0).to.eql(true);",
                  "    pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "    pm.expect(['registration','pdn','chap','user_plane','dns','network'].every(k => Object.prototype.hasOwnProperty.call(j.data, k))).to.eql(true);",
                  "  } else {",
                  "    pm.expect(j.code === 42901).to.eql(true);",
                  "    pm.expect(j.data && j.data.reason === 'diagnostic_busy').to.eql(true);",
                  "  }",
                  "});",
                  "pm.test('capture integrity metadata is conservative and credential-free', () => {",
                  "  if (pm.response.code !== 200) return;",
                  "  const c = j.data.chap;",
                  "  pm.expect(c && typeof c.state === 'string' && typeof c.reason === 'string').to.eql(true);",
                  "  pm.expect(c.capture && typeof c.capture.state === 'string').to.eql(true);",
                  "  pm.expect(['scan_complete','s1ap_observed','chap_observed','pap_observed'].every(k => typeof c[k] === 'boolean')).to.eql(true);",
                  "  if (c.reason === 'capture_incomplete' || c.capture.incomplete === true) {",
                  "    pm.expect(c.scan_complete === false).to.eql(true);",
                  "  }",
                  "  for (const key of ['snapshot_size_bytes','complete_packets']) {",
                  "    if (Object.prototype.hasOwnProperty.call(c.capture, key)) pm.expect(Number.isSafeInteger(c.capture[key]) && c.capture[key] >= 0).to.eql(true);",
                  "  }",
                  "  const serialized = JSON.stringify(c);",
                  "  pm.expect(!/\"(username|password|challenge|response|hash)\"\\s*:/.test(serialized)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Incomplete live capture — synthetic metadata / 合成完整性示例",
              "originalRequest": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/diagnostics/connectivity",
                "description": "Read-only layered evidence. Does not stop the cell, capture new traffic, probe outside, or return credentials. 429 diagnostic_busy is expected for overlap. Live capture integrity is metadata only; incomplete scans are not proof of absent authentication. 不完整抓包不等于无认证，原抓包不变。"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 0,\n  \"message\": \"ok\",\n  \"data\": {\n    \"registration\": {\n      \"state\": \"unknown\",\n      \"scope\": \"aggregate_only\"\n    },\n    \"pdn\": {\n      \"state\": \"unknown\"\n    },\n    \"chap\": {\n      \"state\": \"unknown\",\n      \"reason\": \"capture_incomplete\",\n      \"capture\": {\n        \"state\": \"incomplete\",\n        \"size_bytes\": 4096,\n        \"snapshot_size_bytes\": 4080,\n        \"complete_packets\": 8,\n        \"incomplete\": true\n      },\n      \"s1ap_observed\": true,\n      \"chap_observed\": false,\n      \"pap_observed\": false,\n      \"scan_complete\": false,\n      \"limitations\": [\n        \"A partial scan does not establish protocol absence.\"\n      ]\n    },\n    \"user_plane\": {\n      \"state\": \"not_collected\"\n    },\n    \"dns\": {\n      \"state\": \"not_collected\"\n    },\n    \"network\": {\n      \"state\": \"not_checked\"\n    }\n  },\n  \"request_id\": \"SYNTHETIC_EXAMPLE\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
