{
	"info": {
		"name": "lte-system API",
		"description": "LTE 自建基站工具接口 / API collection for the lte-system lab cell.\n\n变量 Variables: base_url（服务器地址，如 http://192.0.2.10:8081；本机 http://127.0.0.1:8081）, token（服务端设 LTE_API_TOKEN 时才填 Bearer token，默认空=开放模式）.\nLegacy 文件夹是冻结的旧版根路径接口；新集成用 v1 标准 文件夹。详见 docs/API.md / See docs/API.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://192.0.2.10:8081",
			"description": "SDR server address / 服务器地址"
		},
		{
			"key": "token",
			"value": "",
			"description": "Bearer token, empty = open LAN mode / 为空即开放模式"
		}
	],
	"item": [
		{
			"name": "Legacy（兼容旧版 Frozen）",
			"description": "旧版根路径接口：统一 200 + {status,message_id,message}。已冻结，新集成用 v1。/ Frozen legacy routes: always HTTP 200 with {status,message_id,message}.",
			"item": [
				{
					"name": "POST /start（全参数）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"band\": \"7\",\n  \"apn\": \"srsapn\",\n  \"mcc\": \"001\",\n  \"mnc\": \"01\",\n  \"network\": \"eth0\",\n  \"sdr\": \"auto\",\n  \"tx_gain\": 80,\n  \"rx_gain\": 40,\n  \"n_prb\": 25,\n  \"full_net_name\": \"MyLTE\",\n  \"short_net_name\": \"MyLTE\",\n  \"dns\": \"8.8.8.8\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}/start",
						"description": "启动基站约6-10秒，curl 设长超时。band限1/3/5/7/8/34/39/40/41。/ Start cell (~6-10s). band must be one of 1,3,5,7,8,34,39,40,41."
					},
					"response": [
						{
							"name": "启动成功",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"status\": true, \"message_id\": 1, \"message\": \"Start successfully\"}"
						}
					]
				},
				{
					"name": "POST /start（空body复用存档）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/start",
						"description": "空body复用上次成功配置；只传个别字段则其余继承。无存档报id 3。/ Empty body reuses saved profile; partial fields inherit the rest."
					},
					"response": []
				},
				{
					"name": "POST /stop",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/stop",
						"description": "停止基站+抓包并清理iptables。/ Stop cell, capture and iptables rules."
					},
					"response": []
				},
				{
					"name": "POST /basicinfo",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/basicinfo",
						"description": "读第一台终端apn/imsi/ip，取不到为null。/ First attached UE snapshot; missing fields are null."
					},
					"response": [
						{
							"name": "有终端",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"status\": true, \"message_id\": 1, \"message\": \"Getting information success.\", \"apn\": \"srsapn\", \"imsi\": \"001010123456789\", \"ip\": \"172.16.0.2\"}"
						}
					]
				},
				{
					"name": "POST /crackapn（会停基站）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/crackapn",
						"description": "从S1AP包提CHAP后停基站、后台hashcat爆破。需CHAP终端连过。/ Extracts CHAP, STOPS the cell, cracks in background."
					},
					"response": []
				},
				{
					"name": "POST /getcrackresult",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/getcrackresult",
						"description": "取爆破结果，成功追加username/password。/ Fetch crack result."
					},
					"response": []
				},
				{
					"name": "POST /userupload",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [{ "key": "userdb", "type": "file", "src": "user_db.csv", "description": "卡库CSV，Name,Auth,IMSI,Key,OP_Type,OP,AMF,SQN,QCI,IP_alloc" }]
						},
						"url": "{{base_url}}/userupload",
						"description": "上传卡库（8MB内），EPC重启后生效。先在本地准备好文件再选。/ Upload subscriber DB; takes effect after restart."
					},
					"response": []
				},
				{
					"name": "POST /passwordupload",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [{ "key": "wordlist", "type": "file", "src": "wordlist.list", "description": "字典，一行一个候选口令" }]
						},
						"url": "{{base_url}}/passwordupload",
						"description": "上传爆破字典，下次爆破即用。/ Upload crack dictionary."
					},
					"response": []
				},
				{
					"name": "POST /getfile",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\"fileid\": 0}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/getfile",
						"description": "fileid: 0业务流量 1=S1AP 2=eNB空口 3=EPC。成功直接下载。/ Download capture by id."
					},
					"response": []
				},
				{
					"name": "POST /writesim（最小）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\"imsi\": \"001010123456789\"}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/writesim",
						"description": "无读卡器恒返id 2。最长180秒。/ Minimal; id 2 without reader; up to 180s."
					},
					"response": []
				},
				{
					"name": "POST /writesim（全参数）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"imsi\": \"460001234567890\",\n  \"mcc\": \"460\",\n  \"mnc\": \"00\",\n  \"ki\": \"00112233445566778899aabbccddeeff\",\n  \"opc\": \"63bfa50ee6523365ff14c1f45f88737d\",\n  \"op_type\": \"opc\",\n  \"auth\": \"mil\",\n  \"amf\": \"8001\",\n  \"acc\": \"FFFF\",\n  \"spn\": \"MyLTE\",\n  \"card\": \"testsim\",\n  \"qci\": 7,\n  \"sqn\": \"000000001234\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}/writesim",
						"description": "op与opc互斥；iccid:auto保留出厂值；mnc3=true时MNC取3位。/ op/opc mutually exclusive."
					},
					"response": []
				},
				{
					"name": "GET /healthz",
					"request": { "method": "GET", "url": "{{base_url}}/healthz" },
					"response": []
				},
				{
					"name": "GET /status",
					"request": { "method": "GET", "url": "{{base_url}}/status" },
					"response": []
				},
				{
					"name": "GET /profile",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/profile",
						"description": "存档配置+卡库清单（无密钥）。/ Saved profile + UE list (no key material)."
					},
					"response": []
				}
			],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('http 200', () => pm.response.to.have.status(200));",
							"pm.test('json body', () => { pm.response.to.be.json; });"
						]
					}
				}
			]
		},
		{
			"name": "v1 标准 Standard",
			"description": "标准REST：正确状态码 + {code,message,data,request_id} 包络。code 0=成功。详见 docs/API.md。/ Standard REST with proper status codes and envelope.",
			"item": [
				{
					"name": "POST /api/v1/cell（启动）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"band\": \"7\",\n  \"apn\": \"srsapn\",\n  \"mcc\": \"001\",\n  \"mnc\": \"01\",\n  \"network\": \"eth0\",\n  \"n_prb\": 25,\n  \"full_net_name\": \"MyLTE\",\n  \"short_net_name\": \"MyLTE\",\n  \"dns\": \"8.8.8.8\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}/api/v1/cell",
						"description": "空{}复用存档；未知band/非法n_prb报422。/ Empty {} reuses profile; strict validation."
					},
					"response": [
						{
							"name": "成功",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"code\": 0, \"message\": \"cell started\", \"data\": {\"band\": \"7\", \"apn\": \"srsapn\", \"net_name\": \"MyLTE\"}, \"request_id\": \"432678718a07d689\"}"
						}
					]
				},
				{
					"name": "GET /api/v1/cell",
					"request": { "method": "GET", "url": "{{base_url}}/api/v1/cell" },
					"response": [
						{
							"name": "运行中",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"code\": 0, \"message\": \"ok\", \"data\": {\"running\": true, \"epc\": true, \"enb\": true, \"pcap\": true, \"band\": \"7\", \"apn\": \"srsapn\", \"net_name\": \"MyLTE\"}, \"request_id\": \"cebddd5c1be8465c\"}"
						}
					]
				},
				{
					"name": "DELETE /api/v1/cell",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/api/v1/cell",
						"description": "幂等：空闲也返回成功。/ Idempotent."
					},
					"response": []
				},
				{
					"name": "GET /api/v1/ue",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/v1/ue",
						"description": "第一台终端快照；无终端404；没跑412。/ First UE snapshot."
					},
					"response": [
						{
							"name": "有终端",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"code\": 0, \"message\": \"ok\", \"data\": {\"apn\": \"srsapn\", \"imsi\": \"001010123456789\", \"ip\": \"172.16.0.2\"}, \"request_id\": \"9ebe20276037bd66\"}"
						}
					]
				},
				{
					"name": "POST /api/v1/crack/jobs（会停基站）",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/api/v1/crack/jobs",
						"description": "202受理后轮询result。需CHAP终端。/ Returns 202; poll result."
					},
					"response": []
				},
				{
					"name": "GET /api/v1/crack/result",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/v1/crack/result",
						"description": "state: running/ready；字典无口令404。/ Poll state machine."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/config/subscribers",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [{ "key": "userdb", "type": "file", "src": "user_db.csv" }]
						},
						"url": "{{base_url}}/api/v1/config/subscribers",
						"description": "成功data.note提示需重启。/ Note tells restart requirement."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/config/wordlist",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [{ "key": "wordlist", "type": "file", "src": "wordlist.list" }]
						},
						"url": "{{base_url}}/api/v1/config/wordlist"
					},
					"response": []
				},
				{
					"name": "GET captures/lte-data",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/v1/captures/lte-data",
						"description": "id: lte-data|s1ap|enb|epc（兼容0-3）。/ String ids, numeric aliases."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/simcards",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\"imsi\": \"001010123456789\"}", "options": { "raw": { "language": "json" } } },
						"url": "{{base_url}}/api/v1/simcards",
						"description": "未知字段忽略；无读卡器503。/ Unknown fields ignored; 503 without reader."
					},
					"response": []
				},
				{
					"name": "GET /api/v1/profile",
					"request": { "method": "GET", "url": "{{base_url}}/api/v1/profile" },
					"response": [
						{
							"name": "有存档",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\"code\": 0, \"message\": \"ok\", \"data\": {\"has_profile\": true, \"profile\": {\"band\": \"7\", \"apn\": \"srsapn\"}, \"ues\": [{\"name\": \"ue0\", \"auth\": \"mil\", \"imsi\": \"001010123456789\"}]}, \"request_id\": \"06c40143b8842658\"}"
						}
					]
				},
				{
					"name": "GET /api/v1/health",
					"request": { "method": "GET", "url": "{{base_url}}/api/v1/health" },
					"response": []
				}
			],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
							"pm.test('envelope', () => { const j = pm.response.json(); pm.expect(j).to.have.property('code'); pm.expect(j).to.have.property('request_id'); });"
						]
					}
				}
			]
		}
	]
}
