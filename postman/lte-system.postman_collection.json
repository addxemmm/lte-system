                  "  pm.expect(j.data !== null && typeof j.data === 'object').to.eql(true);",
                  "});",
                  "pm.test('bounded UE snapshot schema', () => {",
                  "  const allowed = ['current', 'missing', 'stale', 'invalid', 'cell_stopped'];",
