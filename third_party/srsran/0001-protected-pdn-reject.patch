+bool unpack_pdn_connectivity_request_header(const uint8_t* msg, uint32_t len, uint8_t* eps_bearer_id, uint8_t* pti)
+{
+  if (msg == nullptr || eps_bearer_id == nullptr || pti == nullptr || len < 4 ||
+      (msg[0] & 0x0f) != LIBLTE_MME_PD_EPS_SESSION_MANAGEMENT ||
+      msg[2] != LIBLTE_MME_MSG_TYPE_PDN_CONNECTIVITY_REQUEST) {
+    return false;
+  }
+  *eps_bearer_id = msg[0] >> 4;
+  *pti           = msg[1];
+  return true;
+}
