+inline bool parse_mismatch_policy(const char* value, mismatch_policy_t& out)
+{
+  if (value == nullptr || value[0] == '\0' || std::strcmp(value, "strict") == 0) {
+    out = mismatch_policy_t::strict;
+    return true;
+  }
+  if (std::strcmp(value, "restricted") == 0) {
+    out = mismatch_policy_t::restricted;
+    return true;
+  }
+  return false;
+}
