 namespace srsran {
 
+// Local S11 is an in-process-version UNIX datagram protocol in srsepc. Keep
+// access metadata explicit: a zero-initialized or legacy datagram is deny.
+enum access_policy_t : uint8_t { ACCESS_POLICY_DENY = 0, ACCESS_POLICY_NORMAL = 1, ACCESS_POLICY_RESTRICTED = 2 };
+
+static const uint32_t S11_ACCESS_METADATA_VERSION = 1;
+
+struct gtpc_access_metadata {
+  uint32_t        version;
+  access_policy_t policy;
+  uint8_t         reserved[3];
+  uint64_t        session_generation;
+};
+
+inline bool valid_access_metadata(const gtpc_access_metadata& metadata)
+{
+  return metadata.version == S11_ACCESS_METADATA_VERSION &&
+         (metadata.policy == ACCESS_POLICY_NORMAL || metadata.policy == ACCESS_POLICY_RESTRICTED) &&
+         metadata.session_generation != 0 && metadata.reserved[0] == 0 && metadata.reserved[1] == 0 &&
+         metadata.reserved[2] == 0;
+}
+
