+bool mme_gtpc::send_delete_session_teid(uint32_t teid)
+{
+  if (teid == 0) return false;
+  srsran::gtpc_pdu pdu{};
+  pdu.header.teid_present = true;
+  pdu.header.teid = teid;
+  pdu.header.type = srsran::GTPC_MSG_TYPE_DELETE_SESSION_REQUEST;
+  pdu.choice.delete_session_request.cause.cause_value = srsran::GTPC_CAUSE_VALUE_ISR_DEACTIVATION;
+  // Cleanup must not block the MME event loop when the peer queue is full.
+  return sendto(m_s11, &pdu, sizeof(pdu), MSG_DONTWAIT,
+                (const sockaddr*)&m_spgw_addr, sizeof(m_spgw_addr)) == sizeof(pdu);
+}
+
+void mme_gtpc::retry_pending_deletes()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (now < m_next_delete_retry) return;
+  m_next_delete_retry = now + std::chrono::seconds(1);
+  size_t attempts = 0;
+  for (auto it = m_cancelled_creates.begin(); it != m_cancelled_creates.end() && attempts < 16;) {
+    if (it->second.sgw_ctr_fteid.teid == 0) { ++it; continue; }
+    ++attempts;
+    if (send_delete_session_teid(it->second.sgw_ctr_fteid.teid))
+      it = m_cancelled_creates.erase(it);
+    else
+      ++it;
+  }
 }
 
