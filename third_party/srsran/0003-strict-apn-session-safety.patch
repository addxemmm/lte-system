+bool spgw::gtpu::valid_uplink_locked(uint32_t teid, const uint8_t* data, size_t size)
+{
+  if (!data || size < 20 || (data[0] >> 4) != 4) return false;
+  const size_t ihl = (data[0] & 15) * 4;
+  const size_t total = (size_t(data[2]) << 8) | data[3];
+  if (ihl < 20 || ihl > size || total != size) return false;
+  uint32_t checksum = 0;
+  for (size_t i = 0; i < ihl; i += 2) checksum += (uint32_t(data[i]) << 8) | data[i + 1];
+  while (checksum >> 16) checksum = (checksum & 0xffff) + (checksum >> 16);
+  if (checksum != 0xffff) return false;
+  in_addr_t source;
+  memcpy(&source, data + 12, sizeof(source));
+  auto it = m_up_teid_to_ip.find(teid);
+  return it != m_up_teid_to_ip.end() && it->second == source;
+}
