diff --git a/srsepc/hdr/mme/apn_policy.h b/srsepc/hdr/mme/apn_policy.h
new file mode 100644
index 0000000..958c00e
--- /dev/null
+++ b/srsepc/hdr/mme/apn_policy.h
@@ -0,0 +1,138 @@
+#ifndef SRSEPC_APN_POLICY_H
+#define SRSEPC_APN_POLICY_H
+
+#include "srsran/asn1/liblte_mme.h"
+#include <cstring>
+#include <string>
+
+namespace srsepc {
+namespace apn_policy {
+
+inline bool normalize(const std::string& input, std::string& out)
+{
+  out.clear();
+  if (input.empty() || input.size() > 99) return false;
+  size_t label = 0;
+  bool previous_hyphen = false;
+  for (unsigned char c : input) {
+    if (c == '.') {
+      if (label == 0 || previous_hyphen) return false;
+      label = 0;
+    } else {
+      if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+      if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) return false;
+      if (++label > 63 || (label == 1 && c == '-')) return false;
+    }
+    previous_hyphen = c == '-';
+    out += static_cast<char>(c);
+  }
+  return label != 0 && !previous_hyphen;
+}
+
+struct request {
+  bool present = false;
+  bool eit = false;
+  std::string apn;
+};
+
+// Parse only a bounded inner ESM PDU. Never let a malformed explicit APN
+// turn into the omitted-APN default. Unknown low-bit IEs are fail-closed.
+inline bool parse(const uint8_t* data, size_t size, bool information_response, request& out)
+{
+  out = {};
+  const size_t fixed = information_response ? 3 : 4;
+  if (!data || size < fixed || size > LIBLTE_MAX_MSG_SIZE_BYTES || (data[0] & 15) != 2 ||
+      data[2] != (information_response ? LIBLTE_MME_MSG_TYPE_ESM_INFORMATION_RESPONSE :
+                                         LIBLTE_MME_MSG_TYPE_PDN_CONNECTIVITY_REQUEST)) return false;
+  bool seen_eit = false;
+  for (size_t i = fixed; i < size;) {
+    const uint8_t ie = data[i++];
+    if (ie & 0x80) {
+      if ((ie >> 4) == 0xd) {
+        if (information_response || seen_eit) return false;
+        seen_eit = true;
+        out.eit = (ie & 1) != 0;
+      }
+      continue; // TS 24.007 type-1 optional IE, one octet.
+    }
+    if (ie != 0x28 && ie != 0x27 && ie != 0x33 && ie != 0x66 && ie != 0x7b) return false;
+    const size_t length_bytes = ie == 0x7b ? 2 : 1;
+    if (size - i < length_bytes) return false;
+    size_t length = data[i++];
+    if (length_bytes == 2) length = (length << 8) | data[i++];
+    if (length > size - i) return false;
+    if (ie == 0x28) {
+      if (out.present || length == 0 || length > 100) return false;
+      out.present = true;
+      std::string text;
+      const size_t end = i + length;
+      while (i < end) {
+        const size_t label = data[i++];
+        if (label == 0 || label > 63 || label > end - i) return false;
+        if (!text.empty()) text += '.';
+        text.append(reinterpret_cast<const char*>(data + i), label);
+        i += label;
+      }
+      if (!normalize(text, out.apn)) return false;
+    } else {
+      i += length;
+    }
+  }
+  return true;
+}
+
+inline LIBLTE_ERROR_ENUM unpack_pdn(LIBLTE_BYTE_MSG_STRUCT* msg,
+                                    LIBLTE_MME_PDN_CONNECTIVITY_REQUEST_MSG_STRUCT* out)
+{
+  request parsed;
+  if (!msg || !out || !parse(msg->msg, msg->N_bytes, false, parsed)) return LIBLTE_ERROR_INVALID_INPUTS;
+  *out = {};
+  out->eps_bearer_id = msg->msg[0] >> 4;
+  out->proc_transaction_id = msg->msg[1];
+  out->request_type = msg->msg[3] & 7;
+  out->pdn_type = (msg->msg[3] >> 4) & 7;
+  out->esm_info_transfer_flag_present = parsed.eit;
+  out->esm_info_transfer_flag = static_cast<LIBLTE_MME_ESM_INFO_TRANSFER_FLAG_ENUM>(parsed.eit);
+  out->apn_present = parsed.present;
+  if (parsed.present) std::memcpy(out->apn.apn, parsed.apn.c_str(), parsed.apn.size() + 1);
+  return LIBLTE_SUCCESS;
+}
+
+// Validate the containing Attach before the legacy decoder copies its ESM LV-E.
+// This prevents an advertised 16-bit container length from overrunning either
+// the actual NAS PDU or the fixed LIBLTE message array.
+inline bool validate_attach(const uint8_t* data, size_t size)
+{
+  if (!data || size < 3 || size > LIBLTE_MAX_MSG_SIZE_BYTES || (data[0] & 15) != 7) return false;
+  const unsigned security = data[0] >> 4;
+  if (security > 4) return false;
+  size_t i = security ? 6 : 0;
+  if (i > size || size - i < 3 || data[i] != 7 || data[i + 1] != LIBLTE_MME_MSG_TYPE_ATTACH_REQUEST) return false;
+  i += 3;
+  if (i >= size) return false;
+  size_t length = data[i++];
+  if (length > size - i || length < 1) return false;
+  const uint8_t identity_type = data[i] & 7;
+  if (!((identity_type == LIBLTE_MME_EPS_MOBILE_ID_TYPE_IMSI && length == 8) ||
+        (identity_type == LIBLTE_MME_EPS_MOBILE_ID_TYPE_GUTI && length == 11))) return false;
+  i += length;
+  if (i >= size) return false;
+  length = data[i++];
+  if (length < 2 || length > size - i) return false;
+  i += length;
+  if (size - i < 2) return false;
+  length = (size_t(data[i]) << 8) | data[i + 1];
+  i += 2;
+  if (length > size - i) return false;
+  request parsed;
+  return parse(data + i, length, false, parsed);
+}
+
+inline bool matches(bool present, const std::string& requested, const std::string& configured)
+{
+  std::string allowed, supplied;
+  return normalize(configured, allowed) && (!present || (normalize(requested, supplied) && supplied == allowed));
+}
+} // namespace apn_policy
+} // namespace srsepc
+#endif
