diff --git a/srsepc/hdr/mme/ue_snapshot.h b/srsepc/hdr/mme/ue_snapshot.h
new file mode 100644
index 0000000..d6f18b6
--- /dev/null
+++ b/srsepc/hdr/mme/ue_snapshot.h
@@ -0,0 +1,142 @@
+#ifndef SRSEPC_UE_SNAPSHOT_H
+#define SRSEPC_UE_SNAPSHOT_H
+
+#include "srsepc/hdr/mme/nas.h"
+#include <arpa/inet.h>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cerrno>
+#include <set>
+#include <sstream>
+#include <iomanip>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace srsepc {
+namespace ue_snapshot {
+inline std::string quote(const std::string& input)
+{
+  std::string result = "\"";
+  const char hex[] = "0123456789abcdef";
+  for (unsigned char c : input) {
+    if (c == '"' || c == '\\') { result += '\\'; result += c; }
+    else if (c < 32 || c >= 127) {
+      result += "\\u00"; result += hex[c >> 4]; result += hex[c & 15];
+    } else result += c;
+  }
+  return result + '"';
+}
+
+inline int64_t unix_ms()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+// Caller owns all contexts: invoked only by the MME event loop, never a
+// telemetry/network worker walking mutable NAS pointers concurrently.
+inline std::string sessions(const std::set<const nas*>& contexts, const std::string& run_id)
+{
+  if (contexts.size() > 256) return ""; // Fail stale instead of publishing a partial current view.
+  const char* emm[] = {"deregistered", "common_procedure_initiated", "registered", "deregistered_initiated"};
+  const char* bearer[] = {"deactivated", "requested", "setup", "active"};
+  std::ostringstream out;
+  out << '[';
+  bool first = true;
+  for (const nas* context : contexts) {
+    if (!context) continue;
+    const auto& n = *context;
+    if (n.m_emm_ctx.imsi > 999999999999999ULL) return "";
+    if (unsigned(n.m_emm_ctx.state) >= EMM_STATE_N_ITEMS || unsigned(n.m_ecm_ctx.state) >= ECM_STATE_N_ITEMS) return "";
+    if (!first) out << ',';
+    first = false;
+    char address[INET_ADDRSTRLEN] = {};
+    if (n.m_emm_ctx.ue_ip.s_addr != 0) inet_ntop(AF_INET, &n.m_emm_ctx.ue_ip, address, sizeof(address));
+    std::ostringstream identity;
+    if (n.m_emm_ctx.imsi) identity << std::setw(15) << std::setfill('0') << n.m_emm_ctx.imsi;
+    out << "{\"session_id\":" << quote(run_id + ":" + std::to_string(n.m_session_generation))
+        << ",\"imsi\":" << quote(identity.str())
+        << ",\"mme_ue_s1ap_id\":" << n.m_ecm_ctx.mme_ue_s1ap_id
+        << ",\"enb_ue_s1ap_id\":" << n.m_ecm_ctx.enb_ue_s1ap_id
+        << ",\"sctp_assoc_id\":" << n.m_ecm_ctx.enb_sri.sinfo_assoc_id
+        << ",\"emm_state\":" << quote(emm[n.m_emm_ctx.state])
+        << ",\"ecm_state\":" << quote(n.m_ecm_ctx.state == ECM_STATE_CONNECTED ? "connected" : "idle")
+        << ",\"ue_ipv4\":" << quote(address)
+        << ",\"requested_apn\":" << quote(n.m_requested_apn)
+        << ",\"apn_source\":" << quote(n.m_apn_source)
+        << ",\"selected_apn\":" << quote(n.m_selected_apn)
+        << ",\"apn_validated\":" << (n.m_apn_validated ? "true" : "false")
+        << ",\"bearers\":[";
+    bool first_bearer = true;
+    for (unsigned i = 5; i < MAX_ERABS_PER_UE; ++i) {
+      const auto& b = n.m_esm_ctx[i];
+      if (i != 5 && b.state == ERAB_DEACTIVATED) continue;
+      if (unsigned(b.state) > ERAB_ACTIVE) return "";
+      if (!first_bearer) out << ',';
+      first_bearer = false;
+      out << "{\"ebi\":" << i << ",\"qci\":" << unsigned(b.qci)
+          << ",\"state\":" << quote(bearer[b.state]) << '}';
+    }
+    out << "]}";
+  }
+  out << ']';
+  return out.str();
+}
+
+class writer
+{
+public:
+  writer(const std::string& path, const std::string& run) : path_(path), run_(run), started_(unix_ms()) {}
+  writer() : writer(environment("LTE_UE_SNAPSHOT_PATH"), environment("LTE_UE_RUN_ID")) {}
+  const std::string& run_id() const { return run_; }
+  bool enabled() const
+  {
+    if (path_.empty() || run_.empty() || run_.size() > 128) return false;
+    for (char c : run_) if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.')) return false;
+    return true;
+  }
+  bool publish(const std::string& rows, bool running, bool force = false)
+  {
+    if (!enabled() || rows.empty() || rows.size() > 1024 * 1024) return false;
+    const auto now = std::chrono::steady_clock::now();
+    // Publish after changed control-plane event batches and at least once each second.
+    if (!force && rows == last_rows_ && now - last_write_ < std::chrono::seconds(1)) return true;
+    const int64_t updated = unix_ms();
+    if (updated < started_) return false;
+    std::ostringstream out;
+    out << "{\"schema_version\":1,\"run_id\":" << quote(run_)
+        << ",\"pid\":" << getpid() << ",\"started_at_unix_ms\":" << started_
+        << ",\"updated_at_unix_ms\":" << updated << ",\"sequence\":" << sequence_ + 1
+        << ",\"state\":" << quote(running ? "running" : "stopped") << ",\"sessions\":" << rows << "}\n";
+    const std::string bytes = out.str();
+    std::string temp = path_ + ".tmp.XXXXXX";
+    const int fd = mkstemp(&temp[0]); // Same directory, exclusive creation, mode 0600.
+    if (fd < 0) return false;
+    bool ok = fchmod(fd, S_IRUSR | S_IWUSR) == 0;
+    size_t offset = 0;
+    while (ok && offset < bytes.size()) {
+      ssize_t size = write(fd, bytes.data() + offset, bytes.size() - offset);
+      if (size < 0 && errno == EINTR) continue;
+      if (size <= 0) { ok = false; break; }
+      offset += size;
+    }
+    if (close(fd) != 0) ok = false;
+    if (ok && rename(temp.c_str(), path_.c_str()) != 0) ok = false;
+    if (!ok) { unlink(temp.c_str()); return false; }
+    ++sequence_;
+    last_rows_ = rows;
+    last_write_ = now;
+    return true;
+  }
+private:
+  static std::string environment(const char* name) { const char* value = getenv(name); return value ? value : ""; }
+  std::string path_, run_, last_rows_;
+  int64_t started_;
+  uint64_t sequence_ = 0;
+  std::chrono::steady_clock::time_point last_write_{};
+};
+} // namespace ue_snapshot
+} // namespace srsepc
+#endif
