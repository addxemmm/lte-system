+      ((uint32_t(msg->msg[2]) << 8) | msg->msg[3]) != msg->N_bytes - 8) return;
+  uint32_t teid;
+  memcpy(&teid, msg->msg + 4, sizeof(teid));
+  teid = ntohl(teid);
+  std::lock_guard<std::mutex> lock(m_tunnel_mutex);
+  if (!valid_uplink_locked(teid, msg->msg + 8, msg->N_bytes - 8)) return;
+  // Runtime GTP-C and GTP-U dispatch share one SPGW event loop.
+  if (write(m_sgi, msg->msg + 8, msg->N_bytes - 8) < 0) m_logger.error("Could not write to TUN interface.");
