+void nas::set_pdn_apn(const LIBLTE_MME_PDN_CONNECTIVITY_REQUEST_MSG_STRUCT& request)
+{
+  m_session_generation = next_session_generation.fetch_add(1);
+  m_apn_present = request.apn_present;
+  m_emm_ctx.procedure_transaction_id = request.proc_transaction_id;
+  m_emm_ctx.requested_pdn_type = request.pdn_type;
+  const size_t length = strnlen(request.apn.apn, sizeof(request.apn.apn));
+  m_requested_apn = request.apn_present ? std::string(request.apn.apn, length) : std::string();
+  m_apn_source = request.apn_present ? "pdn_request" : "omitted";
+  m_emm_ctx.ue_ip.s_addr = 0;
+  m_selected_apn.clear();
+  m_apn_validated = m_security_ready = m_waiting_esm = m_session_requested = m_pdn_rejected = false;
+}
+
+bool nas::apn_allowed() const
+{
+  return apn_policy::matches(m_apn_present, m_requested_apn, m_apn);
+}
+
+bool nas::start_pdn_session()
+{
+  if (!m_security_ready || m_waiting_esm || m_session_requested || m_pdn_rejected) return false;
+  if (!apn_allowed()) return reject_initial_pdn(27);
+  apn_policy::normalize(m_apn, m_selected_apn);
+  m_apn_validated = true;
+  m_session_requested = true;
+  if (!m_gtpc->send_create_session_request(m_emm_ctx.imsi)) return reject_initial_pdn(26);
+  return true;
+}
+
+void nas::clear_pdn_session()
+{
+  m_session_requested = m_waiting_esm = m_apn_validated = false;
+  m_selected_apn.clear();
+  m_emm_ctx.state = EMM_STATE_DEREGISTERED;
+  m_emm_ctx.ue_ip.s_addr = 0;
+  m_emm_ctx.sgw_ctrl_fteid = {};
+  for (auto& bearer : m_esm_ctx) {
+    bearer.state = ERAB_DEACTIVATED;
+    bearer.pdn_addr_alloc = {};
+    bearer.enb_fteid = {};
+    bearer.sgw_s1u_fteid = {};
+  }
+}
+
+bool nas::reject_initial_pdn(uint8_t esm_cause)
+{
+  if (m_pdn_rejected) return false;
+  m_pdn_rejected = true;
+  m_apn_validated = false;
+  m_selected_apn.clear();
+  m_waiting_esm = false;
+  if (m_session_requested) m_gtpc->send_delete_session_request(m_emm_ctx.imsi);
+  clear_pdn_session();
+  LIBLTE_MME_PDN_CONNECTIVITY_REJECT_MSG_STRUCT pdn{};
+  pdn.proc_transaction_id = m_emm_ctx.procedure_transaction_id;
+  pdn.esm_cause = esm_cause;
+  LIBLTE_MME_ATTACH_REJECT_MSG_STRUCT reject{};
+  reject.emm_cause = LIBLTE_MME_EMM_CAUSE_ESM_FAILURE;
+  reject.esm_msg_present = true;
+  if (liblte_mme_pack_pdn_connectivity_reject_msg(&pdn, &reject.esm_msg) != LIBLTE_SUCCESS) return false;
+  LIBLTE_BYTE_MSG_STRUCT plain{};
+  if (liblte_mme_pack_attach_reject_msg(&reject, &plain) != LIBLTE_SUCCESS) return false;
+  auto tx = srsran::make_byte_buffer();
+  if (!tx || plain.N_bytes + 6 > tx->get_tailroom()) return false;
+  if (m_security_ready) {
+    tx->msg[0] = (LIBLTE_MME_SECURITY_HDR_TYPE_INTEGRITY_AND_CIPHERED << 4) | LIBLTE_MME_PD_EPS_MOBILITY_MANAGEMENT;
+    memset(tx->msg + 1, 0, 4);
+    tx->msg[5] = ++m_sec_ctx.dl_nas_count & 255;
+    memcpy(tx->msg + 6, plain.msg, plain.N_bytes);
+    tx->N_bytes = plain.N_bytes + 6;
+    cipher_encrypt(tx.get());
+    uint8_t mac[4]{};
+    integrity_generate(tx.get(), mac);
+    memcpy(tx->msg + 1, mac, 4);
+  } else {
+    memcpy(tx->msg, plain.msg, plain.N_bytes);
+    tx->N_bytes = plain.N_bytes;
+  }
+  const bool sent = m_s1ap->send_downlink_nas_transport(
+      m_ecm_ctx.enb_ue_s1ap_id, m_ecm_ctx.mme_ue_s1ap_id, tx.get(), m_ecm_ctx.enb_sri);
+  m_s1ap->send_ue_context_release_command(m_ecm_ctx.mme_ue_s1ap_id);
+  return sent;
+}
